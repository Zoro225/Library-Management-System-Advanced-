# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/libraryhub"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Must match the exact URL you use to access the app in the browser
# (your deployed domain in production, or http://localhost:3000 locally).
NEXTAUTH_URL="http://localhost:3000"
